{
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/docs", "destination": "/securegraph/docs", "permanent": true },
    { "source": "/platform/infrastructure", "destination": "/platform/cloud", "permanent": true },
    { "source": "/sandbox-apply", "destination": "https://app.phantixlabs.com/sandbox-apply", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://staging.phantix.site/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
